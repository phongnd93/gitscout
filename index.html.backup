    // ==========================================
    // STATE MANAGEMENT
    // ==========================================

    let currentPage = 'trending';
    let currentCategory = 'all';
    let currentTimeRange = 'today';
    let searchQuery = '';
    let currentOppType = 'all';
    let isLoading = false;

    // Charting instances & global active repository tracker
    let currentActiveRepo = null;
    let chartStarVelocity = null;
    let chartCommitVitality = null;
    let chartIssueFriction = null;

    // ==========================================
    // THEME MANAGEMENT
    // ==========================================

    function initTheme() {
      const saved = localStorage.getItem('theme');
      if (saved === 'light') {
        document.documentElement.classList.remove('dark');
        document.documentElement.classList.add('light');
        updateThemeIcons(false);
      } else {
        document.documentElement.classList.remove('light');
        document.documentElement.classList.add('dark');
        updateThemeIcons(true);
      }
    }

    function toggleTheme() {
      const isDark = document.documentElement.classList.contains('dark');
      if (isDark) {
        document.documentElement.classList.remove('dark');
        document.documentElement.classList.add('light');
        localStorage.setItem('theme', 'light');
        updateThemeIcons(false);
      } else {
        document.documentElement.classList.remove('light');
        document.documentElement.classList.add('dark');
        localStorage.setItem('theme', 'dark');
        updateThemeIcons(true);
      }

      // If viewing repository details, dynamically re-render the charts to match the new theme
      const detailPage = document.getElementById('page-opp-detail');
      if (detailPage && !detailPage.classList.contains('hidden') && currentActiveRepo) {
        renderRepositoryCharts(currentActiveRepo);
      }
    }

    function updateThemeIcons(isDark) {
      document.getElementById('theme-icon-dark').classList.toggle('hidden', !isDark);
      document.getElementById('theme-icon-light').classList.toggle('hidden', isDark);
    }

    // ==========================================
    // PAGE NAVIGATION
    // ==========================================

    // ==========================================
    // ROUTING ENGINE (Hash Router)
    // ==========================================

    function handleRouting() {
      const hash = window.location.hash || '#/trending';
      
      if (hash.startsWith('#/opportunity/')) {
        const parts = hash.split('/');
        const param = parts[2];
        let repo = null;
        
        // Try to parse as integer ID first
        const repoId = parseInt(param);
        if (!isNaN(repoId)) {
          repo = opportunityRepos.find(r => r.id === repoId) || trendingRepos.find(r => r.id === repoId);
        }
        
        // If not found by ID, try finding by owner/name
        if (!repo && parts[3]) {
          const owner = parts[2].toLowerCase();
          const name = parts[3].toLowerCase();
          repo = opportunityRepos.find(r => r.owner.toLowerCase() === owner && r.name.toLowerCase() === name) ||
                 trendingRepos.find(r => r.owner.toLowerCase() === owner && r.name.toLowerCase() === name);
        }
        
        if (repo) {
          openDetail(repo.id);
        } else {
          window.location.hash = '#/opportunity';
        }
      } else if (hash === '#/opportunity') {
        renderPage('opportunity');
      } else {
        renderPage('trending');
      }
    }

    function renderPage(page) {
      currentPage = page;

      const trendingTab = document.getElementById('tab-trending');
      const opportunityTab = document.getElementById('tab-opportunity');
      const trendingIndicator = document.getElementById('trending-indicator');
      const opportunityIndicator = document.getElementById('opportunity-indicator');

      if (page === 'trending') {
        trendingTab.classList.remove('text-zinc-500', 'dark:text-zinc-400');
        trendingTab.classList.add('text-gray-900', 'dark:text-dark-text');
        opportunityTab.classList.remove('text-gray-900', 'dark:text-dark-text');
        opportunityTab.classList.add('text-zinc-500', 'dark:text-zinc-400');
        trendingIndicator.classList.remove('hidden');
        opportunityIndicator.classList.add('hidden');
      } else {
        opportunityTab.classList.remove('text-zinc-500', 'dark:text-zinc-400');
        opportunityTab.classList.add('text-gray-900', 'dark:text-dark-text');
        trendingTab.classList.remove('text-gray-900', 'dark:text-dark-text');
        trendingTab.classList.add('text-zinc-500', 'dark:text-zinc-400');
        opportunityIndicator.classList.remove('hidden');
        trendingIndicator.classList.add('hidden');
      }

      document.getElementById('page-trending').classList.toggle('hidden', page !== 'trending');
      document.getElementById('page-opportunity').classList.toggle('hidden', page !== 'opportunity');
      document.getElementById('page-opp-detail').classList.add('hidden');
      document.getElementById('nav-tabs').classList.remove('hidden');

      if (page === 'trending') {
        renderTrendingPage();
      } else {
        renderOpportunityPage();
      }
    }

    function switchPage(page) {
      window.location.hash = `#/${page}`;
    }

    function goBackFromDetail() {
      if (currentPage === 'trending') {
        window.location.hash = '#/trending';
      } else {
        window.location.hash = '#/opportunity';
      }
    }

    // ==========================================
    // TRENDING PAGE LOGIC
    // ==========================================

    function filterCategory(category) {
      currentCategory = category;
      document.querySelectorAll('.category-pill').forEach(pill => {
        if (pill.dataset.category === category) {
          pill.classList.add('active');
        } else {
          pill.classList.remove('active');
        }
      });
      renderTrendingGrid();
    }

    function setTimeRange(range) {
      currentTimeRange = range;
      document.querySelectorAll('.time-btn').forEach(btn => {
        if (btn.dataset.range === range) {
          btn.classList.add('bg-accent', 'text-white');
          btn.classList.remove('text-zinc-500', 'dark:text-zinc-400');
        } else {
          btn.classList.remove('bg-accent', 'text-white');
          btn.classList.add('text-zinc-500', 'dark:text-zinc-400');
        }
      });
      renderTrendingGrid();
    }

    function applyFilters() {
      searchQuery = document.getElementById('search-input').value.toLowerCase();
      renderTrendingGrid();
    }

    function getFilteredTrendingRepos() {
      return trendingRepos.filter(repo => {
        if (currentCategory !== 'all' && repo.category !== currentCategory) return false;
        const langFilter = document.getElementById('language-filter').value;
        if (langFilter && repo.language !== langFilter) return false;
        if (searchQuery) {
          const searchStr = `${repo.owner} ${repo.name} ${repo.description} ${repo.topics.join(' ')}`.toLowerCase();
          if (!searchStr.includes(searchQuery)) return false;
        }
        return true;
      });
    }

    function renderTrendingPage() {
      showLoading('loading-state');
      hideAll('trending-grid', 'empty-state');
      setTimeout(() => renderTrendingGrid(), 500);
    }

    function renderTrendingGrid() {
      const grid = document.getElementById('trending-grid');
      const loading = document.getElementById('loading-state');
      const empty = document.getElementById('empty-state');

      loading.classList.add('hidden');
      const repos = getFilteredTrendingRepos();

      if (repos.length === 0) {
        grid.classList.add('hidden');
        empty.classList.remove('hidden');
        return;
      }

      empty.classList.add('hidden');
      grid.classList.remove('hidden');
      grid.innerHTML = repos.map(repo => createRepoCard(repo)).join('');
    }

    // ==========================================
    // OPPORTUNITY PAGE LOGIC
    // ==========================================

    function selectOpportunityType(type) {
      currentOppType = type;
      document.querySelectorAll('.opp-type-card').forEach(card => {
        if (card.dataset.opp === type) {
          card.classList.add('selected');
        } else {
          card.classList.remove('selected');
        }
      });
      renderOpportunityGrid();
    }

    function getFilteredOpportunityRepos() {
      if (currentOppType === 'all') return opportunityRepos;
      return opportunityRepos.filter(repo => repo.oppType === currentOppType);
    }

    function renderOpportunityPage() {
      showLoading('opp-loading-state');
      hideAll('opportunity-grid', 'opp-empty-state');
      setTimeout(() => renderOpportunityGrid(), 500);
    }

    function renderOpportunityGrid() {
      const grid = document.getElementById('opportunity-grid');
      const loading = document.getElementById('opp-loading-state');
      const empty = document.getElementById('opp-empty-state');

      loading.classList.add('hidden');
      const repos = getFilteredOpportunityRepos();

      if (repos.length === 0) {
        grid.classList.add('hidden');
        empty.classList.remove('hidden');
        return;
      }

      empty.classList.add('hidden');
      grid.classList.remove('hidden');
      grid.innerHTML = repos.map(repo => createRepoCard(repo, true)).join('');
    }

    function navigateToDetail(repoId) {
      const repo = opportunityRepos.find(r => r.id === repoId) || trendingRepos.find(r => r.id === repoId);
      if (repo) {
        window.location.hash = `#/opportunity/${repo.owner}/${repo.name}`;
      } else {
        window.location.hash = `#/opportunity/${repoId}`;
      }
    }

    // ==========================================
    // CARD RENDERING
    // ==========================================

    function createRepoCard(repo, showBadge = false) {
      const badgeHtml = showBadge ? getOpportunityBadge(repo.oppType) : '';
      const clickFn = `navigateToDetail(${repo.id})`;

      return `
        <div class="repo-card p-4 rounded-card border border-gray-200 dark:border-dark-border bg-white dark:bg-dark-surface cursor-pointer" onclick="${clickFn}">
          <div class="flex gap-3 mb-3">
            <img src="${repo.avatar}" alt="${repo.owner}/${repo.name}" class="w-10 h-10 rounded-lg bg-gray-50 dark:bg-dark-bg">
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2">
                <h3 class="text-sm font-semibold text-gray-900 dark:text-dark-text truncate">${repo.owner}/${repo.name}</h3>
                ${badgeHtml}
              </div>
              <p class="text-xs text-zinc-500 dark:text-zinc-400">${repo.description.substring(0, 50)}${repo.description.length > 50 ? '...' : ''}</p>
            </div>
          </div>
          <p class="text-sm text-zinc-600 dark:text-zinc-400 line-clamp-2 mb-3">${repo.description}</p>
          <div class="flex flex-wrap gap-1.5 mb-3">
            ${repo.topics.slice(0, 4).map(topic => `
              <span class="px-2 py-0.5 text-xs rounded-pill bg-gray-50 dark:bg-dark-bg text-zinc-600 dark:text-zinc-400 border border-gray-200 dark:border-dark-border">${topic}</span>
            `).join('')}
          </div>
          <div class="flex items-center gap-4 text-xs text-zinc-500 dark:text-zinc-400">
            <span class="flex items-center gap-1">
              <i class="ph ph-star text-yellow-500"></i>
              <span class="font-mono">${formatNumber(repo.stars)}</span>
            </span>
            <span class="flex items-center gap-1 text-green-500">
              <i class="ph ph-trend-up"></i>
              <span class="font-mono">+${formatNumber(repo.starDelta)}</span>
            </span>
            <span class="flex items-center gap-1">
              <span class="w-2 h-2 rounded-full bg-${getLanguageColor(repo.language)}"></span>
              <span>${repo.language}</span>
            </span>
            <span class="flex items-center gap-1">
              <i class="ph ph-git-fork"></i>
              <span class="font-mono">${formatNumber(repo.forks)}</span>
            </span>
          </div>
        </div>
      `;
    }

    function getOpportunityBadge(type) {
      const badges = {
        rising: '<span class="badge bg-green-500/20 text-green-500">Rising</span>',
        bounty: '<span class="badge bg-accent/20 text-accent">Bounty</span>',
        abandoned: '<span class="badge bg-amber-500/20 text-amber-500">Abandoned</span>',
        firstpr: '<span class="badge bg-green-500/20 text-green-500">Good First Issue</span>',
        design: '<span class="badge bg-purple-500/20 text-purple-500">Design Polish</span>'
      };
      return badges[type] || '';
    }

    function getLanguageColor(lang) {
      const colors = {
        python: 'blue-400',
        javascript: 'yellow-400',
        typescript: 'blue-500',
        rust: 'orange-500',
        go: 'cyan-400',
        java: 'red-400',
        cpp: 'purple-400',
        swift: 'orange-400',
        dart: 'blue-400',
        yaml: 'pink-400',
        css: 'purple-500',
        html: 'orange-500',
        markdown: 'emerald-500'
      };
      return colors[lang] || 'zinc-400';
    }

    function formatNumber(num) {
      if (num >= 1000) return (num / 1000).toFixed(1).replace(/\.0$/, '') + 'k';
      return num.toString();
    }

    // ==========================================
    // OPPORTUNITY DETAIL PAGE
    // ==========================================

    function openDetail(repoId) {
      const repo = opportunityRepos.find(r => r.id === repoId) || trendingRepos.find(r => r.id === repoId);
      if (!repo) return;

      // Hide other lists, show detail page
      document.getElementById('page-opportunity').classList.add('hidden');
      document.getElementById('page-trending').classList.add('hidden');
      document.getElementById('page-opp-detail').classList.remove('hidden');
      document.getElementById('nav-tabs').classList.add('hidden');

      // Header
      document.getElementById('detail-avatar').src = repo.avatar;
      document.getElementById('detail-avatar').alt = `${repo.owner}/${repo.name}`;
      document.getElementById('detail-repo-name').textContent = `${repo.owner}/${repo.name}`;
      document.getElementById('detail-badge').innerHTML = getOpportunityBadge(repo.oppType);

      // Meta line (stars · forks · language · license)
      document.getElementById('detail-meta').innerHTML = `
        <span class="flex items-center gap-1"><i class="ph ph-star text-yellow-500"></i>${formatNumber(repo.stars)}</span>
        <span class="flex items-center gap-1"><i class="ph ph-git-fork"></i>${formatNumber(repo.forks)}</span>
        <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-${getLanguageColor(repo.language)}"></span>${repo.language}</span>
        <span>${repo.description.substring(0, 80)}${repo.description.length > 80 ? '...' : ''}</span>
      `;

      // GitHub link
      document.getElementById('detail-github-link').href = `https://github.com/${repo.owner}/${repo.name}`;

      // ★ OPPORTUNITY SPOTLIGHT CONTAINER STYLING & POPULATING
      const spotlightBox = document.getElementById('detail-spotlight-box');
      const iconWrap = document.getElementById('detail-spotlight-icon-wrapper');
      const icon = document.getElementById('detail-spotlight-icon');
      const label = document.getElementById('detail-spotlight-label');
      
      const typeStyles = {
        rising: {
          border: 'border-green-500/30',
          bg: 'bg-green-500/5',
          iconBg: 'bg-green-500/20',
          iconColor: 'text-green-500',
          label: 'Rising Star Spotlight',
          iconClass: 'ph-trend-up'
        },
        bounty: {
          border: 'border-indigo-500/30',
          bg: 'bg-indigo-500/5',
          iconBg: 'bg-indigo-500/20',
          iconColor: 'text-indigo-500',
          label: 'Issue Bounty Spotlight',
          iconClass: 'ph-currency-circle-dollar'
        },
        abandoned: {
          border: 'border-amber-500/30',
          bg: 'bg-amber-500/5',
          iconBg: 'bg-amber-500/20',
          iconColor: 'text-amber-500',
          label: 'Abandoned Gold Spotlight',
          iconClass: 'ph-archive'
        },
        firstpr: {
          border: 'border-emerald-500/30',
          bg: 'bg-emerald-500/5',
          iconBg: 'bg-emerald-500/20',
          iconColor: 'text-emerald-500',
          label: 'First PR Friendly Spotlight',
          iconClass: 'ph-hand-waving'
        },
        design: {
          border: 'border-purple-500/30',
          bg: 'bg-purple-500/5',
          iconBg: 'bg-purple-500/20',
          iconColor: 'text-purple-500',
          label: 'Design Polish Spotlight',
          iconClass: 'ph-paint-brush-broad'
        }
      };

      const style = typeStyles[repo.oppType] || typeStyles.rising;
      spotlightBox.className = `rounded-card p-6 md:p-8 mb-6 border ${style.border} ${style.bg} transition-all duration-300 shadow-[inset_0_1px_0_rgba(255,255,255,0.05)]`;
      iconWrap.className = `w-8 h-8 rounded-lg ${style.iconBg} flex items-center justify-center animate-pulse`;
      icon.className = `ph ${style.iconClass} text-base ${style.iconColor}`;
      label.textContent = style.label;
      label.className = `text-xs font-semibold uppercase tracking-wider ${style.iconColor}`;

      // Populate text nodes with SaaS-focused value propositions
      document.getElementById('detail-pitch').textContent = repo.opportunityPitch || repo.forkOpportunity;
      document.getElementById('detail-gap-text').textContent = repo.opportunityGap || 'The core codebase is currently extremely difficult to host and lacks key customer-facing features like integrated Auth, Stripe billing flows, or collaboration dashboards. Users are actively begging for a managed cloud instance.';
      document.getElementById('detail-target-text').textContent = repo.opportunityTargetAreas || 'Launch a hosted cloud-managed solution, simplify docker scripting, or wrap the terminal CLI tool in a gorgeous web GUI dashboard.';
      document.getElementById('detail-roi-text').textContent = repo.opportunityROI || 'Build a steady stream of monthly recurring revenue (MRR). By resolving hosting friction, you can capture an active audience of technical users willing to pay for convenience.';

      // Opportunity Breakdown Grid
      const breakdown = document.getElementById('detail-opportunity-breakdown');
      const opps = getOpportunityBreakdown(repo);
      breakdown.innerHTML = opps.map(opp => `
        <div class="p-4 rounded-card border border-gray-200/60 dark:border-dark-border/60 bg-white/60 dark:bg-dark-surface/60 backdrop-blur-sm">
          <div class="flex items-center gap-2 mb-2">
            <span class="text-base">${opp.emoji}</span>
            <h4 class="text-sm font-medium text-gray-900 dark:text-dark-text">${opp.title}</h4>
          </div>
          <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed mb-3">${opp.description}</p>
          <div class="flex items-center gap-2">
            <span class="badge diff-${opp.difficulty}">${opp.difficulty}</span>
            <span class="text-xs text-zinc-500 dark:text-zinc-400 font-mono">${opp.time}</span>
          </div>
        </div>
      `).join('');

      // Quick Action Bar
      const actionBar = document.getElementById('detail-action-bar');
      const actions = getQuickActions(repo);
      actionBar.innerHTML = actions.map(action => `
        <a href="${action.url}" target="_blank" rel="noopener" class="flex items-center gap-2 px-4 py-2 text-sm font-medium rounded-small ${action.primary ? 'bg-accent text-white hover:bg-accent/90' : 'bg-white dark:bg-dark-surface text-gray-900 dark:text-dark-text border border-gray-200 dark:border-dark-border hover:border-accent'} transition-colors">
          <i class="ph ${action.icon}"></i>
          ${action.label}
        </a>
      `).join('');

      // Topics
      document.getElementById('detail-topics').innerHTML = repo.topics.map(topic =>
        `<span class="px-2 py-0.5 text-xs rounded-pill bg-gray-50 dark:bg-dark-bg text-zinc-600 dark:text-zinc-400 border border-gray-200 dark:border-dark-border">${topic}</span>`
      ).join('');

      // Quick Stats
      document.getElementById('detail-stars').textContent = formatNumber(repo.stars);
      document.getElementById('detail-star-delta').textContent = `+${formatNumber(repo.starDelta)}`;
      document.getElementById('detail-health').textContent = repo.healthScore || '--';
      document.getElementById('detail-health-label').textContent = repo.healthScore ? getHealthLabel(repo.healthScore) : 'N/A';
      document.getElementById('detail-forks').textContent = formatNumber(repo.forks);

      // Bus Factor
      const busEl = document.getElementById('detail-bus');
      busEl.textContent = repo.busFactor !== undefined ? repo.busFactor : '--';
      busEl.className = `text-2xl font-mono font-semibold ${getBusColor(repo.busFactor)}`;
      document.getElementById('detail-bus-label').textContent = repo.busFactor !== undefined ? getBusLabel(repo.busFactor) : 'N/A';

      // Render Trend & Vitality Intelligence Dashboard Charts (ApexCharts)
      renderRepositoryCharts(repo);

      // Signals
      if (repo.signals && repo.signals.length > 0) {
        document.getElementById('detail-signals-section').classList.remove('hidden');
        document.getElementById('detail-signals').innerHTML = repo.signals.map(signal => `
          <div class="signal-${signal.type} p-3 rounded-card border border-gray-200 dark:border-dark-border bg-white dark:bg-dark-surface">
            <div class="flex items-center gap-3">
              <i class="ph ${signal.icon} text-base ${getSignalColor(signal.type)}"></i>
              <span class="text-sm text-gray-900 dark:text-dark-text">${signal.text}</span>
            </div>
          </div>
        `).join('');
      } else {
        document.getElementById('detail-signals-section').classList.add('hidden');
      }

      // Issues
      if (repo.issues && repo.issues.length > 0) {
        document.getElementById('detail-issues-section').classList.remove('hidden');
        document.getElementById('detail-issues').innerHTML = repo.issues.map(issue => `
          <div class="issue-card p-4 rounded-card border border-gray-200 dark:border-dark-border bg-white dark:bg-dark-surface ${issue.labels.includes('urgent') || issue.labels.includes('critical') ? 'pulse-urgent' : ''}">
            <div class="flex items-start justify-between gap-3 mb-2">
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 mb-1">
                  <span class="font-mono text-xs text-zinc-500 dark:text-zinc-400">#${issue.num}</span>
                  <h4 class="text-sm font-medium text-gray-900 dark:text-dark-text">${issue.title}</h4>
                </div>
                <div class="flex flex-wrap gap-1.5">
                  ${issue.labels.map(label => `
                    <span class="px-2 py-0.5 text-xs rounded-pill bg-gray-100 dark:bg-dark-bg text-zinc-600 dark:text-zinc-400 border border-gray-200 dark:border-dark-border">${label}</span>
                  `).join('')}
                </div>
              </div>
              <div class="flex flex-col items-end gap-1 flex-shrink-0">
                <span class="badge diff-${issue.difficulty}">${issue.difficulty}</span>
                <span class="text-xs text-zinc-500 dark:text-zinc-400 font-mono">${issue.time}</span>
              </div>
            </div>
          </div>
        `).join('');
      } else {
        document.getElementById('detail-issues-section').classList.add('hidden');
      }

      // Contribution Guide
      if (repo.contributionGuide && repo.contributionGuide.length > 0) {
        document.getElementById('detail-guide-section').classList.remove('hidden');
        document.getElementById('detail-guide').innerHTML = repo.contributionGuide.map((step, idx) => `
          <div class="step-connector flex gap-4 pb-6">
            <div class="w-9 h-9 rounded-lg bg-accent/10 flex items-center justify-center flex-shrink-0">
              <i class="ph ${step.icon} text-base text-accent"></i>
            </div>
            <div class="flex-1 pt-1">
              <h4 class="text-sm font-medium text-gray-900 dark:text-dark-text mb-1">Step ${step.step}: ${step.title}</h4>
              <p class="text-xs font-mono text-zinc-500 dark:text-zinc-400 bg-gray-50 dark:bg-dark-bg px-3 py-2 rounded-small border border-gray-200 dark:border-dark-border">${step.detail}</p>
            </div>
          </div>
        `).join('');
      } else {
        document.getElementById('detail-guide-section').classList.add('hidden');
      }

      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function getOpportunityBreakdown(repo) {
      const opps = [];
      const type = repo.oppType;

      if (type === 'rising') {
        opps.push({
          emoji: '🚀', title: 'Early Contributor Advantage',
          description: 'Shape the architecture before it gets locked in. Early contributors become core maintainers.',
          difficulty: 'medium', time: 'Long-term ROI'
        });
        opps.push({
          emoji: '📈', title: 'Growing Community',
          description: `${formatNumber(repo.stars)} stars with ${repo.starDelta > 500 ? 'rapid' : 'steady'} growth. Your contributions get maximum visibility.`,
          difficulty: 'easy', time: 'Visibility boost'
        });
        opps.push({
          emoji: '🔧', title: 'Open Architecture Decisions',
          description: 'Key design decisions are still being made. Your input on RFCs and issues has real weight.',
          difficulty: 'hard', time: 'High impact'
        });
      } else if (type === 'bounty') {
        const bountyIssues = (repo.issues || []).filter(i => i.labels.includes('bounty'));
        const totalBounty = bountyIssues.reduce((sum, i) => {
          const match = i.time.match(/\$(\d+)/);
          return sum + (match ? parseInt(match[1]) : 0);
        }, 0);
        opps.push({
          emoji: '💰', title: `${totalBounty > 0 ? '$' + totalBounty + ' in' : 'Active'} Bounties`,
          description: bountyIssues.length > 0 ? `Issues: ${bountyIssues.map(i => '#' + i.num).join(', ')}. Claim before starting work.` : 'Active bounty program with rewards for quality contributions.',
          difficulty: 'medium', time: `${bountyIssues.length} bounties`
        });
        opps.push({
          emoji: '🧪', title: 'Skill Building',
          description: `Real-world ${repo.language} codebase used in production. Learn from battle-tested patterns.`,
          difficulty: 'easy', time: 'Learning value'
        });
        opps.push({
          emoji: '🌐', title: 'Enterprise Exposure',
          description: 'Contributions to infrastructure repos get seen by companies using them. Career leverage.',
          difficulty: 'medium', time: 'Career ROI'
        });
      } else if (type === 'abandoned') {
        opps.push({
          emoji: '👑', title: 'Become the Maintainer',
          description: `With ${formatNumber(repo.stars)} stars and zero active maintainers, a fork by YOU becomes the de facto version.`,
          difficulty: 'hard', time: 'Community leadership'
        });
        opps.push({
          emoji: '🐛', title: 'Fix Critical Issues',
          description: 'Security patches and bugs pile up when nobody is minding the store. Quick wins available.',
          difficulty: 'medium', time: '1-2 days each'
        });
        opps.push({
          emoji: '📦', title: 'Merge Unmerged PRs',
          description: 'Dozens of community PRs with improvements sit unreviewed. Cherry-pick the best ones.',
          difficulty: 'easy', time: 'Quick wins'
        });
      } else if (type === 'firstpr') {
        opps.push({
          emoji: '👋', title: 'Beginner-Friendly Issues',
          description: `${(repo.issues || []).filter(i => i.labels.some(l => l.includes('good-first') || l.includes('first-timer'))).length} issues explicitly labeled for newcomers. Clear scope, guided by maintainers.`,
          difficulty: 'easy', time: '2-4 hours each'
        });
        opps.push({
          emoji: '🤝', title: 'Active Mentorship',
          description: 'Responsive maintainers who review PRs quickly and provide constructive feedback.',
          difficulty: 'easy', time: 'Support available'
        });
        opps.push({
          emoji: '📝', title: 'Documentation Wins',
          description: 'Doc improvements are always welcome and get merged fastest. Low risk, high visibility.',
          difficulty: 'easy', time: '1-3 hours'
        });
      } else if (type === 'design') {
        opps.push({
          emoji: '🎨', title: 'UI/UX Enhancement',
          description: 'Refactor components, add responsive viewport overrides, and configure complex grid structures (CSS/Tailwind v4).',
          difficulty: 'medium', time: 'Creative scope'
        });
        opps.push({
          emoji: '✨', title: 'Aesthetic Polish',
          description: 'Make components look modern and premium: configure glowing radial hover effects, active wiggles, and glassmorphic refractions.',
          difficulty: 'easy', time: '1-3 hours each'
        });
        opps.push({
          emoji: '📱', title: 'Fluid Interactivity',
          description: 'Implement layout transitions and micro-interactions (e.g. Framer Motion, GSAP, CSS clips) to deliver smooth visuals.',
          difficulty: 'medium', time: 'Interactive depth'
        });
      } else {
        // Fallback for 'all' or unknown types
        opps.push({
          emoji: '🔍', title: 'Open Issues',
          description: `${(repo.issues || []).length} actionable issues waiting for contributors.`,
          difficulty: 'varies', time: 'Varies'
        });
        opps.push({
          emoji: '📊', title: 'Project Health',
          description: `Health score: ${repo.healthScore}/100. ${repo.healthScore >= 70 ? 'Active project with good governance.' : 'Room for improvement — your contribution matters.'}`,
          difficulty: 'medium', time: 'Assessment'
        });
        opps.push({
          emoji: '🏗️', title: 'Contribute',
          description: repo.forkOpportunity || 'Multiple contribution paths available.',
          difficulty: 'medium', time: 'Get started'
        });
      }

      return opps;
    }

    function getQuickActions(repo) {
      const actions = [];
      const ghUrl = `https://github.com/${repo.owner}/${repo.name}`;

      actions.push({ icon: 'ph-git-fork', label: 'Fork Repository', url: ghUrl + '/fork', primary: true });

      const firstIssue = (repo.issues || []).find(i => i.labels.some(l => l.includes('good-first') || l.includes('first-timer') || l.includes('bounty')));
      if (firstIssue) {
        actions.push({ icon: 'ph-flag', label: `Start with #${firstIssue.num}`, url: ghUrl + `/issues/${firstIssue.num}`, primary: false });
      }

      actions.push({ icon: 'ph-book-open', label: 'Read CONTRIBUTING', url: ghUrl + '/blob/main/CONTRIBUTING.md', primary: false });
      actions.push({ icon: 'ph-git-pull-request', label: 'Open Issues', url: ghUrl + '/issues', primary: false });

      return actions;
    }

    function getBusColor(factor) {
      if (factor <= 1) return 'text-red-500';
      if (factor <= 3) return 'text-amber-500';
      return 'text-green-500';
    }

    function getBusLabel(factor) {
      if (factor <= 1) return 'Critical risk';
      if (factor <= 3) return 'Moderate risk';
      return 'Healthy';
    }

    // ==========================================
    // TRENDING MODAL (for trending repos)
    // ==========================================

    function openModal(repoId) {
      const repo = trendingRepos.find(r => r.id === repoId);
      if (!repo) return;

      document.getElementById('modal-avatar').src = repo.avatar;
      document.getElementById('modal-avatar').alt = `${repo.owner}/${repo.name}`;
      document.getElementById('modal-title').textContent = `${repo.owner}/${repo.name}`;
      document.getElementById('modal-subtitle').textContent = repo.description;

      // Hide opportunity-specific sections for trending repos
      document.getElementById('modal-health').classList.add('hidden');
      document.getElementById('modal-sparkline').classList.add('hidden');
      document.getElementById('modal-signals').classList.add('hidden');
      document.getElementById('modal-bus').classList.add('hidden');
      document.getElementById('modal-fork').classList.add('hidden');

      const overlay = document.getElementById('modal-overlay');
      overlay.classList.remove('hidden');
      overlay.classList.add('flex');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      const overlay = document.getElementById('modal-overlay');
      overlay.classList.add('hidden');
      overlay.classList.remove('flex');
      document.body.style.overflow = '';
    }

    function closeModalOutside(event) {
      if (event.target === event.currentTarget) closeModal();
    }

    // ==========================================
    // UTILITY FUNCTIONS
    // ==========================================

    function showLoading(id) {
      document.getElementById(id).classList.remove('hidden');
    }

    function hideAll(...ids) {
      ids.forEach(id => document.getElementById(id).classList.add('hidden'));
    }

    function getHealthLabel(score) {
      if (score >= 80) return 'Excellent health';
      if (score >= 60) return 'Good health';
      if (score >= 40) return 'Needs attention';
      return 'At risk';
    }

    function getSignalColor(type) {
      const colors = {
        positive: 'text-green-500',
        warning: 'text-amber-500',
        negative: 'text-red-500',
        neutral: 'text-zinc-600 dark:text-zinc-400'
      };
      return colors[type] || 'text-zinc-600 dark:text-zinc-400';
    }

    // ==========================================
    // KEYBOARD NAVIGATION
    // ==========================================

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        if (!document.getElementById('page-opp-detail').classList.contains('hidden')) {
          goBackFromDetail();
        } else {
          closeModal();
        }
      }
    });

    // ==========================================
    // DATA GENERATION & CHART INTELLIGENCE (GitScout Analytics Engine)
    // ==========================================

    function getOrCreateTrendData(repo) {
      if (repo.trendData) return repo.trendData;

      // Base randomizer keyed by repo ID to make data deterministic for the same repo
      const seed = repo.id;
      const pseudoRandom = (offset) => {
        const x = Math.sin(seed + offset) * 10000;
        return x - Math.floor(x);
      };

      const months = ['Dec 2025', 'Jan 2026', 'Feb 2026', 'Mar 2026', 'Apr 2026', 'May 2026'];
      const commitMonths = ['Jun 25', 'Jul 25', 'Aug 25', 'Sep 25', 'Oct 25', 'Nov 25', 'Dec 25', 'Jan 26', 'Feb 26', 'Mar 26', 'Apr 26', 'May 26'];
      
      let starHistory = [];
      let commitHistory = [];
      let openIssues = repo.issues ? repo.issues.length * 12 : 24;
      let closedIssues = Math.floor(openIssues * (3.5 + pseudoRandom(1) * 2));
      
      // Calculate growth and vitality patterns based on opportunity type
      if (repo.oppType === 'rising') {
        // High exponential star growth
        let currentStars = repo.stars;
        starHistory = [
          Math.floor(currentStars * 0.4),
          Math.floor(currentStars * 0.5),
          Math.floor(currentStars * 0.65),
          Math.floor(currentStars * 0.78),
          Math.floor(currentStars * 0.9),
          currentStars
        ];
        
        // Active and expanding commits
        commitHistory = Array.from({ length: 12 }, (_, i) => {
          return Math.floor(25 + pseudoRandom(i) * 35 + (i * 2));
        });
        
        // High issue resolution rate
        closedIssues = Math.floor(openIssues * (5 + pseudoRandom(2) * 3));
      } else if (repo.oppType === 'abandoned') {
        // Flat or slowing star growth
        let currentStars = repo.stars;
        starHistory = [
          Math.floor(currentStars * 0.92),
          Math.floor(currentStars * 0.94),
          Math.floor(currentStars * 0.96),
          Math.floor(currentStars * 0.98),
          Math.floor(currentStars * 0.99),
          currentStars
        ];
        
        // Dropping commits down to zero over 12 months (decaying)
        commitHistory = Array.from({ length: 12 }, (_, i) => {
          const decayFactor = Math.max(0, 1 - (i / 10)); // drop to 0 by month 10
          return Math.floor((15 + pseudoRandom(i) * 25) * decayFactor);
        });
        
        // Very low issue resolution rate (friction is high)
        closedIssues = Math.floor(openIssues * (0.8 + pseudoRandom(2) * 0.4));
      } else if (repo.oppType === 'bounty') {
        // Steady linear growth
        let currentStars = repo.stars;
        starHistory = [
          Math.floor(currentStars * 0.8),
          Math.floor(currentStars * 0.84),
          Math.floor(currentStars * 0.88),
          Math.floor(currentStars * 0.92),
          Math.floor(currentStars * 0.96),
          currentStars
        ];
        
        // Stable commits
        commitHistory = Array.from({ length: 12 }, (_, i) => {
          return Math.floor(10 + pseudoRandom(i) * 25);
        });
        
        // Medium resolution rate
        closedIssues = Math.floor(openIssues * (2 + pseudoRandom(2) * 1.5));
      } else if (repo.oppType === 'design') {
        // High star growth recently (viral design trend)
        let currentStars = repo.stars;
        starHistory = [
          Math.floor(currentStars * 0.6),
          Math.floor(currentStars * 0.68),
          Math.floor(currentStars * 0.76),
          Math.floor(currentStars * 0.84),
          Math.floor(currentStars * 0.92),
          currentStars
        ];
        
        // Active commits
        commitHistory = Array.from({ length: 12 }, (_, i) => {
          return Math.floor(15 + pseudoRandom(i) * 30);
        });
        
        // High resolution
        closedIssues = Math.floor(openIssues * (3 + pseudoRandom(2) * 2));
      } else {
        // default (firstpr or standard)
        let currentStars = repo.stars;
        starHistory = [
          Math.floor(currentStars * 0.85),
          Math.floor(currentStars * 0.88),
          Math.floor(currentStars * 0.91),
          Math.floor(currentStars * 0.94),
          Math.floor(currentStars * 0.97),
          currentStars
        ];
        
        commitHistory = Array.from({ length: 12 }, (_, i) => {
          return Math.floor(8 + pseudoRandom(i) * 18);
        });
        
        closedIssues = Math.floor(openIssues * (4 + pseudoRandom(2) * 2));
      }

      repo.trendData = {
        months,
        starHistory,
        commitMonths,
        commitHistory,
        issuesRatio: {
          open: openIssues,
          closed: closedIssues,
          total: openIssues + closedIssues,
          rate: Math.round((closedIssues / (openIssues + closedIssues)) * 100)
        }
      };

      return repo.trendData;
    }

    function getApexChartThemeOptions() {
      const isDark = document.documentElement.classList.contains('dark');
      return {
        textColor: isDark ? '#8e8ea0' : '#4a4a5a',
        gridBorderColor: isDark ? 'rgba(26, 26, 46, 0.6)' : 'rgba(208, 208, 216, 0.4)',
        tooltipTheme: isDark ? 'dark' : 'light',
        tooltipBg: isDark ? '#0c0c14' : '#ffffff',
        tooltipBorder: isDark ? '#1a1a2e' : '#d0d0d8'
      };
    }

    function renderRepositoryCharts(repo) {
      const trend = getOrCreateTrendData(repo);
      
      // Ensure we set the global active repo
      currentActiveRepo = repo;

      // Update the badge/labels for status if applicable
      const starGrowthRateEl = document.getElementById('star-growth-rate');
      if (starGrowthRateEl) {
        if (repo.oppType === 'rising') {
          starGrowthRateEl.textContent = '+142.8% MoM';
          starGrowthRateEl.className = 'badge bg-green-500/10 text-green-500 font-mono text-xs';
        } else if (repo.oppType === 'abandoned') {
          starGrowthRateEl.textContent = '+0.8% MoM (Stalled)';
          starGrowthRateEl.className = 'badge bg-red-500/10 text-red-500 font-mono text-xs';
        } else {
          starGrowthRateEl.textContent = `+${repo.starDelta > 500 ? '24.5%' : '12.3%'} MoM`;
          starGrowthRateEl.className = 'badge bg-green-500/10 text-green-500 font-mono text-xs';
        }
      }

      const commitVitalityEl = document.getElementById('commit-vitality-status');
      if (commitVitalityEl) {
        if (repo.oppType === 'abandoned') {
          commitVitalityEl.textContent = 'Decaying Goldmine: Inactive Maintainer';
          commitVitalityEl.className = 'badge bg-amber-500/10 text-amber-500 font-mono text-xs';
        } else if (repo.oppType === 'rising') {
          commitVitalityEl.textContent = 'High Vitality: Growing Activity';
          commitVitalityEl.className = 'badge bg-green-500/10 text-green-500 font-mono text-xs';
        } else {
          commitVitalityEl.textContent = 'Stable Maintenance';
          commitVitalityEl.className = 'badge bg-zinc-500/10 text-zinc-500 dark:text-zinc-400 font-mono text-xs';
        }
      }

      // Check if ApexCharts is available
      if (typeof ApexCharts === 'undefined') {
        console.warn('ApexCharts is not defined. Rendering high-fidelity SVG and CSS fallbacks.');
        renderFallbackCharts(repo, trend);
        return;
      }

      try {
        const theme = getApexChartThemeOptions();

        // Destroy existing chart instances to avoid overlap / memory leaks
        if (chartStarVelocity) { chartStarVelocity.destroy(); chartStarVelocity = null; }
        if (chartCommitVitality) { chartCommitVitality.destroy(); chartCommitVitality = null; }
        if (chartIssueFriction) { chartIssueFriction.destroy(); chartIssueFriction = null; }

        // ==========================================
        // 1. STAR VELOCITY & MOMENTUM CURVE (Area Chart)
        // ==========================================
        const starOptions = {
          series: [{
            name: 'Total Stars',
            data: trend.starHistory
          }],
          chart: {
            type: 'line',
            height: 250,
            toolbar: { show: false },
            background: 'transparent',
            fontFamily: 'Geist Sans, sans-serif',
            animations: {
              enabled: true,
              easing: 'cubic-bezier(0.16, 1, 0.3, 1)',
              speed: 600
            }
          },
          colors: ['#6366f1'],
          stroke: {
            curve: 'smooth',
            width: 3
          },
          dataLabels: { enabled: false },
          xaxis: {
            categories: trend.months,
            axisBorder: { show: false },
            axisTicks: { show: false },
            labels: {
              style: {
                colors: theme.textColor,
                fontSize: '10px',
                fontFamily: 'Geist Mono, monospace'
              }
            }
          },
          yaxis: {
            labels: {
              formatter: (val) => formatNumber(val),
              style: {
                colors: theme.textColor,
                fontSize: '10px',
                fontFamily: 'Geist Mono, monospace'
              }
            }
          },
          grid: {
            borderColor: theme.gridBorderColor,
            strokeDashArray: 4,
            xaxis: { lines: { show: false } },
            yaxis: { lines: { show: true } }
          },
          tooltip: {
            theme: theme.tooltipTheme,
            style: {
              fontSize: '11px',
              fontFamily: 'Geist Mono, monospace'
            }
          }
        };

        chartStarVelocity = new ApexCharts(document.querySelector("#chart-star-velocity"), starOptions);
        chartStarVelocity.render();

        // ==========================================
        // 2. 12-MONTH DEVELOPMENT VITALITY (Bar Chart)
        // ==========================================
        const commitOptions = {
          series: [{
            name: 'Monthly Commits',
            data: trend.commitHistory
          }],
          chart: {
            type: 'bar',
            height: 220,
            toolbar: { show: false },
            background: 'transparent',
            fontFamily: 'Geist Sans, sans-serif',
            animations: {
              enabled: true,
              easing: 'easeout',
              speed: 500
            }
          },
          plotOptions: {
            bar: {
              borderRadius: 3,
              columnWidth: '60%'
            }
          },
          colors: [function({ value, seriesIndex, dataPointIndex, w }) {
            if (repo.oppType === 'abandoned' && dataPointIndex >= 9) {
              return '#ef4444'; // Red for decay
            }
            return '#6366f1';
          }],
          dataLabels: { enabled: false },
          xaxis: {
            categories: trend.commitMonths,
            axisBorder: { show: false },
            axisTicks: { show: false },
            labels: {
              style: {
                colors: theme.textColor,
                fontSize: '9px',
                fontFamily: 'Geist Mono, monospace'
              }
            }
          },
          yaxis: {
            labels: {
              style: {
                colors: theme.textColor,
                fontSize: '10px',
                fontFamily: 'Geist Mono, monospace'
              }
            }
          },
          grid: {
            borderColor: theme.gridBorderColor,
            strokeDashArray: 4,
            xaxis: { lines: { show: false } },
            yaxis: { lines: { show: true } }
          },
          tooltip: {
            theme: theme.tooltipTheme,
            style: {
              fontSize: '11px',
              fontFamily: 'Geist Mono, monospace'
            }
          }
        };

        chartCommitVitality = new ApexCharts(document.querySelector("#chart-commit-vitality"), commitOptions);
        chartCommitVitality.render();

        // ==========================================
        // 3. ISSUE FRICTION & RESOLUTION RATE (Donut Chart)
        // ==========================================
        const issueOptions = {
          series: [trend.issuesRatio.closed, trend.issuesRatio.open],
          labels: ['Resolved Issues', 'Open Friction'],
          chart: {
            type: 'donut',
            height: 250,
            background: 'transparent',
            fontFamily: 'Geist Sans, sans-serif'
          },
          colors: ['#22c55e', '#ef4444'],
          stroke: {
            show: true,
            width: 2,
            colors: [document.documentElement.classList.contains('dark') ? '#0c0c14' : '#ffffff']
          },
          plotOptions: {
            pie: {
              donut: {
                size: '72%',
                background: 'transparent',
                labels: {
                  show: true,
                  name: {
                    show: true,
                    fontSize: '11px',
                    fontFamily: 'Geist Sans, sans-serif',
                    color: theme.textColor,
                    offsetY: -8
                  },
                  value: {
                    show: true,
                    fontSize: '18px',
                    fontFamily: 'Geist Mono, monospace',
                    fontWeight: '600',
                    color: document.documentElement.classList.contains('dark') ? '#e0e0e8' : '#1a1a2e',
                    offsetY: 8,
                    formatter: (val) => val
                  },
                  total: {
                    show: true,
                    label: 'Resolution Rate',
                    color: theme.textColor,
                    fontSize: '10px',
                    formatter: (w) => `${trend.issuesRatio.rate}%`
                  }
                }
              }
            }
          },
          dataLabels: { enabled: false },
          legend: {
            show: true,
            position: 'bottom',
            fontFamily: 'Geist Sans, sans-serif',
            labels: { colors: theme.textColor },
            fontSize: '11px',
            markers: { width: 8, height: 8, radius: 4 }
          },
          tooltip: {
            theme: theme.tooltipTheme,
            y: { formatter: (val) => `${val} issues` }
          }
        };

        chartIssueFriction = new ApexCharts(document.querySelector("#chart-issue-friction"), issueOptions);
        chartIssueFriction.render();
      } catch (err) {
        console.error('Error rendering ApexCharts:', err);
        renderFallbackCharts(repo, trend);
      }
    }

    function renderFallbackCharts(repo, trend) {
      const isDark = document.documentElement.classList.contains('dark');
      const strokeColor = '#6366f1';
      const fillColor = isDark ? 'rgba(99, 102, 241, 0.15)' : 'rgba(99, 102, 241, 0.08)';
      const labelColor = isDark ? '#a0a0b0' : '#4a4a5a';
      const gridColor = isDark ? 'rgba(26, 26, 46, 0.4)' : 'rgba(208, 208, 216, 0.3)';

      // ==========================================
      // 1. STAR VELOCITY FALLBACK (Inline SVG Area)
      // ==========================================
      const starHistory = trend.starHistory;
      const maxStar = Math.max(...starHistory);
      const minStar = Math.min(...starHistory);
      const range = maxStar - minStar || 1;
      
      const width = 500;
      const height = 180;
      const padding = 20;
      const chartW = width - padding * 2;
      const chartH = height - padding * 2;
      
      const points = starHistory.map((val, idx) => {
        const x = padding + (idx / (starHistory.length - 1)) * chartW;
        const y = padding + chartH - ((val - minStar) / range) * chartH;
        return { x, y, val, month: trend.months[idx] };
      });
      
      const polylinePoints = points.map(p => `${p.x},${p.y}`).join(' ');
      
      const starSvg = `
        <div class="relative w-full h-full flex flex-col justify-between p-2">
          <svg viewBox="0 0 ${width} ${height}" class="w-full h-44">
            <!-- Grid Lines -->
            <line x1="${padding}" y1="${padding}" x2="${width - padding}" y2="${padding}" stroke="${gridColor}" stroke-dasharray="4" />
            <line x1="${padding}" y1="${padding + chartH/2}" x2="${width - padding}" y2="${padding + chartH/2}" stroke="${gridColor}" stroke-dasharray="4" />
            <line x1="${padding}" y1="${padding + chartH}" x2="${width - padding}" y2="${padding + chartH}" stroke="${gridColor}" stroke-dasharray="4" />
            
            <!-- Line path -->
            <polyline points="${polylinePoints}" fill="none" stroke="${strokeColor}" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
            
            <!-- Interactive Dots -->
            ${points.map(p => `
              <circle cx="${p.x}" cy="${p.y}" r="4" fill="${strokeColor}" stroke="${isDark ? '#0c0c14' : '#ffffff'}" stroke-width="1.5" title="${p.month}: ${formatNumber(p.val)} stars" />
            `).join('')}
          </svg>
          <!-- X-Axis Labels -->
          <div class="flex justify-between px-4 text-[9px] font-mono" style="color: ${labelColor}">
            ${points.map(p => `<span>${p.month}</span>`).join('')}
          </div>
        </div>
      `;
      document.getElementById('chart-star-velocity').innerHTML = starSvg;

      // ==========================================
      // 2. COMMIT VITALITY FALLBACK (CSS Column Bars)
      // ==========================================
      const commitHistory = trend.commitHistory;
      const maxCommit = Math.max(...commitHistory) || 1;
      
      const commitHtml = `
        <div class="w-full h-40 flex items-end gap-1.5 px-2 mt-4">
          ${commitHistory.map((val, idx) => {
            const percentHeight = Math.max(5, (val / maxCommit) * 100);
            const isDecay = repo.oppType === 'abandoned' && idx >= 9;
            const bgColor = isDecay ? 'bg-red-500/70 hover:bg-red-500' : 'bg-accent/80 hover:bg-accent';
            return `
              <div class="flex-1 flex flex-col items-center gap-1 group h-full justify-end">
                <span class="text-[8px] font-mono scale-90 opacity-0 group-hover:opacity-100 transition-opacity duration-150" style="color: ${labelColor}">${val}</span>
                <div class="${bgColor} w-full rounded-t-sm transition-all duration-200" style="height: ${percentHeight}px" title="${trend.commitMonths[idx]}: ${val} commits"></div>
                <span class="text-[8px] font-mono mt-1 scale-90 whitespace-nowrap" style="color: ${labelColor}">${trend.commitMonths[idx]}</span>
              </div>
            `;
          }).join('')}
        </div>
      `;
      document.getElementById('chart-commit-vitality').innerHTML = commitHtml;

      // ==========================================
      // 3. ISSUE FRICTION FALLBACK (CSS Circle Radial/Grid)
      // ==========================================
      const open = trend.issuesRatio.open;
      const closed = trend.issuesRatio.closed;
      const total = open + closed;
      const rate = trend.issuesRatio.rate;
      
      const frictionHtml = `
        <div class="w-full h-full flex flex-col items-center justify-center p-2">
          <div class="relative w-28 h-28 flex items-center justify-center rounded-full border-8" style="border-color: ${isDark ? 'rgba(34, 197, 94, 0.15)' : 'rgba(34, 197, 94, 0.1)'}">
            <div class="absolute inset-0 rounded-full border-8 border-transparent border-t-red-500 border-r-red-500" style="transform: rotate(${-45 + (open/total)*360}deg); opacity: 0.85;"></div>
            <div class="text-center">
              <span class="text-[8px] block uppercase tracking-wider font-semibold" style="color: ${labelColor}">Resolution</span>
              <span class="text-lg font-semibold font-mono text-gray-900 dark:text-dark-text">${rate}%</span>
            </div>
          </div>
          
          <div class="flex justify-between w-full mt-4 text-[9px] px-2 font-mono" style="color: ${labelColor}">
            <div class="flex items-center gap-1">
              <span class="w-2 h-2 rounded-full bg-green-500 block"></span>
              <span>Resolved: ${closed}</span>
            </div>
            <div class="flex items-center gap-1">
              <span class="w-2 h-2 rounded-full bg-red-500 block"></span>
              <span>Friction: ${open}</span>
            </div>
          </div>
        </div>
      `;
      document.getElementById('chart-issue-friction').innerHTML = frictionHtml;
    }

    // ==========================================
    // INITIALIZATION
    // ==========================================

    document.addEventListener('DOMContentLoaded', () => {
      initTheme();
      handleRouting();
    });

    window.addEventListener('hashchange', handleRouting);
  </script>
</body>
</html>
