<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>GitScout — Open-Source Opportunity Scout</title>

  <!-- Tailwind CDN -->
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- Geist Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Geist+Sans:wght@400;500;600;700&family=Geist+Mono:wght@400;500;600&display=swap" rel="stylesheet">

  <!-- Phosphor Icons -->
  <script src="https://unpkg.com/@phosphor-icons/web@2.0.3"></script>

  <!-- ApexCharts CDN for stunning dark-tech charts -->
  <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>

  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            dark: {
              bg: '#06060b',
              surface: '#0c0c14',
              border: '#1a1a2e',
              text: '#e0e0e8'
            },
            light: {
              bg: '#fafafa',
              surface: '#f0f0f5',
              border: '#d0d0d8',
              text: '#1a1a2e'
            },
            accent: '#6366f1'
          },
          fontFamily: {
            sans: ['Geist Sans', 'sans-serif'],
            mono: ['Geist Mono', 'monospace']
          },
          borderRadius: {
            'card': '6px',
            'small': '4px',
            'pill': '2px'
          }
        }
      }
    }
  </script>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Geist Sans', sans-serif;
      min-height: 100dvh;
      transition: background-color 0.2s ease, color 0.2s ease;
      background-color: #fafafa;
      color: #1a1a2e;
    }

    .dark body {
      background-color: #06060b;
      color: #e0e0e8;
    }

    /* Card hover effect & Double-border styling */
    .repo-card {
      transition: border-color 0.25s cubic-bezier(0.16, 1, 0.3, 1), transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s cubic-bezier(0.16, 1, 0.3, 1);
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.01), inset 0 1px 0 rgba(255, 255, 255, 0.7);
    }

    .dark .repo-card {
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25), inset 0 1px 0 rgba(255, 255, 255, 0.02);
    }

    .repo-card:hover {
      border-color: #6366f1;
      transform: translateY(-2px);
      box-shadow: 0 12px 24px rgba(99, 102, 241, 0.04), inset 0 1px 0 rgba(255, 255, 255, 0.85);
    }

    .dark .repo-card:hover {
      box-shadow: 0 12px 32px rgba(99, 102, 241, 0.08), inset 0 1px 0 rgba(255, 255, 255, 0.05);
    }

    /* Skeleton loading animation */
    @keyframes shimmer {
      0% { background-position: -200% 0; }
      100% { background-position: 200% 0; }
    }

    .skeleton {
      background: linear-gradient(90deg, #d0d0d8 25%, #e0e0e8 50%, #d0d0d8 75%);
      background-size: 200% 100%;
      animation: shimmer 1.5s infinite;
      border-radius: 4px;
    }

    .dark .skeleton {
      background: linear-gradient(90deg, #1a1a2e 25%, #252540 50%, #1a1a2e 75%);
      background-size: 200% 100%;
    }

    /* Modal backdrop */
    .modal-backdrop {
      background-color: rgba(250, 250, 250, 0.85);
    }

    .dark .modal-backdrop {
      background-color: rgba(6, 6, 11, 0.85);
    }

    /* Sparkline bars */
    .sparkline-bar {
      transition: height 0.3s ease;
    }

    /* Signal item borders */
    .signal-positive {
      border-left: 3px solid #22c55e;
    }

    .signal-warning {
      border-left: 3px solid #f59e0b;
    }

    .signal-negative {
      border-left: 3px solid #ef4444;
    }

    .signal-neutral {
      border-left: 3px solid #71717a;
    }

    /* Tab underline animation */
    .tab-underline {
      transition: width 0.2s ease;
    }

    /* Category pills */
    .category-pill {
      transition: background-color 0.15s ease, color 0.15s ease;
    }

    .category-pill:hover {
      background-color: #6366f1;
      color: white;
    }

    .category-pill.active {
      background-color: #6366f1;
      color: white;
    }

    /* Opportunity type cards & Interactive active tactile physics */
    .opp-type-card {
      transition: border-color 0.25s cubic-bezier(0.16, 1, 0.3, 1), transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), background-color 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }
 
    .opp-type-card:hover {
      border-color: #6366f1;
      transform: translateY(-2px);
    }
 
    .opp-type-card.selected {
      border-color: #6366f1;
      background-color: rgba(99, 102, 241, 0.08);
    }
 
    .dark .opp-type-card.selected {
      background-color: rgba(99, 102, 241, 0.1);
    }

    /* Global active scaling for interactive elements */
    button:active, .opp-type-card:active, .category-pill:active, .time-btn:active, select:active, input:active, a:active {
      transform: scale(0.98) !important;
    }
    
    button, .opp-type-card, .category-pill, .time-btn, select, input, a {
      transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    }

    /* Scrollbar styling */
    ::-webkit-scrollbar {
      width: 8px;
    }

    ::-webkit-scrollbar-track {
      background: #f0f0f5;
    }

    ::-webkit-scrollbar-thumb {
      background: #d0d0d8;
      border-radius: 4px;
    }

    ::-webkit-scrollbar-thumb:hover {
      background: #b0b0b8;
    }

    .dark ::-webkit-scrollbar-track {
      background: #0c0c14;
    }

    .dark ::-webkit-scrollbar-thumb {
      background: #1a1a2e;
    }

    .dark ::-webkit-scrollbar-thumb:hover {
      background: #252540;
    }

    /* Select dropdown dark mode */
    .dark select option {
      background-color: #0c0c14;
      color: #e0e0e8;
    }

    /* Input placeholder */
    .placeholder-zinc-500::placeholder {
      color: #71717a;
    }

    .dark .placeholder-zinc-500::placeholder {
      color: #52525b;
    }

    /* Line clamp utility */
    .line-clamp-2 {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    /* Badge styles */
    .badge {
      font-size: 0.65rem;
      padding: 2px 6px;
      border-radius: 2px;
      font-weight: 500;
    }

    /* Theme toggle button */
    .theme-toggle {
      transition: transform 0.2s ease;
    }

    .theme-toggle:hover {
      transform: scale(1.1);
    }

    /* Input focus ring */
    input:focus, select:focus {
      outline: none;
      border-color: #6366f1;
    }

    /* Detail page hero gradient */
    .opp-hero {
      background: linear-gradient(135deg, rgba(99, 102, 241, 0.12) 0%, rgba(168, 85, 247, 0.08) 50%, rgba(59, 130, 246, 0.06) 100%);
    }

    .dark .opp-hero {
      background: linear-gradient(135deg, rgba(99, 102, 241, 0.15) 0%, rgba(168, 85, 247, 0.1) 50%, rgba(59, 130, 246, 0.08) 100%);
    }

    /* Issue card hover */
    .issue-card {
      transition: border-color 0.15s ease, transform 0.15s ease;
    }

    .issue-card:hover {
      border-color: #6366f1;
      transform: translateY(-1px);
    }

    /* Step connector line */
    .step-connector {
      position: relative;
    }

    .step-connector::after {
      content: '';
      position: absolute;
      left: 18px;
      top: 40px;
      bottom: -8px;
      width: 2px;
      background: #d0d0d8;
    }

    .dark .step-connector::after {
      background: #1a1a2e;
    }

    .step-connector:last-child::after {
      display: none;
    }

    /* Back button */
    .back-btn {
      transition: transform 0.15s ease;
    }

    .back-btn:hover {
      transform: translateX(-3px);
    }

    /* Difficulty badges */
    .diff-easy {
      background-color: rgba(34, 197, 94, 0.15);
      color: #22c55e;
    }

    .diff-medium {
      background-color: rgba(245, 158, 11, 0.15);
      color: #f59e0b;
    }

    .diff-hard {
      background-color: rgba(239, 68, 68, 0.15);
      color: #ef4444;
    }

    /* Pulse animation for urgent items */
    @keyframes pulse-border {
      0%, 100% { border-color: rgba(239, 68, 68, 0.3); }
      50% { border-color: rgba(239, 68, 68, 0.8); }
    }

    .pulse-urgent {
      animation: pulse-border 2s infinite;
    }
  </style>
</head>
<body class="antialiased">

  <!-- TOP NAVIGATION BAR -->
  <nav class="sticky top-0 z-50 border-b border-gray-200 dark:border-dark-border bg-gray-50 dark:bg-dark-bg/95 bg-light-bg/95 backdrop-blur-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-14">
        <!-- Logo -->
        <div class="flex items-center gap-2">
          <i class="ph ph-binoculars text-xl text-accent"></i>
          <span class="text-2xl font-semibold tracking-tight text-gray-900 dark:text-dark-text">GitScout</span>
        </div>

        <!-- Center Nav Tabs -->
        <div id="nav-tabs" class="flex items-center gap-1 relative">
          <button id="tab-trending" onclick="switchPage('trending')" class="px-4 py-2 text-sm font-medium text-gray-900 dark:text-dark-text relative">
            Trending
            <div id="trending-indicator" class="absolute bottom-0 left-0 right-0 h-0.5 bg-accent tab-underline"></div>
          </button>
          <button id="tab-opportunity" onclick="switchPage('opportunity')" class="px-4 py-2 text-sm font-medium text-zinc-500 dark:text-zinc-400 relative">
            Opportunity
            <div id="opportunity-indicator" class="absolute bottom-0 left-0 right-0 h-0.5 bg-accent tab-underline hidden"></div>
          </button>
        </div>

        <!-- Theme Toggle -->
        <button onclick="toggleTheme()" class="theme-toggle p-2 rounded-small hover:bg-white dark:bg-dark-surface hover:bg-light-surface" aria-label="Toggle theme">
          <i id="theme-icon-dark" class="ph ph-moon text-lg text-gray-900 dark:text-dark-text"></i>
          <i id="theme-icon-light" class="ph ph-sun text-lg text-gray-900 dark:text-dark-text hidden"></i>
        </button>
      </div>
    </div>
  </nav>

  <!-- MAIN CONTENT -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">

    <!-- TRENDING PAGE -->
    <div id="page-trending">
      <!-- Page Header -->
      <div class="mb-6">
        <h1 class="text-3xl font-semibold tracking-tight leading-none text-gray-900 dark:text-dark-text mb-2">Trending Repositories</h1>
        <p class="text-sm text-zinc-500 dark:text-zinc-400">Scout top repositories and hunt for high-growth open-source opportunities.</p>
      </div>

      <!-- Filter Bar -->
      <div class="mb-6 space-y-4">
        <!-- Category Pills -->
        <div class="flex flex-wrap gap-2">
          <button onclick="filterCategory('all')" class="category-pill active px-3 py-1.5 text-xs font-medium rounded-pill bg-white dark:bg-dark-surface text-gray-900 dark:text-dark-text border border-gray-200 dark:border-dark-border" data-category="all">All</button>
          <button onclick="filterCategory('ai')" class="category-pill px-3 py-1.5 text-xs font-medium rounded-pill bg-white dark:bg-dark-surface text-gray-900 dark:text-dark-text border border-gray-200 dark:border-dark-border" data-category="ai">AI/ML</button>
          <button onclick="filterCategory('devtools')" class="category-pill px-3 py-1.5 text-xs font-medium rounded-pill bg-white dark:bg-dark-surface text-gray-900 dark:text-dark-text border border-gray-200 dark:border-dark-border" data-category="devtools">DevTools</button>
          <button onclick="filterCategory('web')" class="category-pill px-3 py-1.5 text-xs font-medium rounded-pill bg-white dark:bg-dark-surface text-gray-900 dark:text-dark-text border border-gray-200 dark:border-dark-border" data-category="web">Web</button>
          <button onclick="filterCategory('mobile')" class="category-pill px-3 py-1.5 text-xs font-medium rounded-pill bg-white dark:bg-dark-surface text-gray-900 dark:text-dark-text border border-gray-200 dark:border-dark-border" data-category="mobile">Mobile</button>
          <button onclick="filterCategory('data')" class="category-pill px-3 py-1.5 text-xs font-medium rounded-pill bg-white dark:bg-dark-surface text-gray-900 dark:text-dark-text border border-gray-200 dark:border-dark-border" data-category="data">Data</button>
          <button onclick="filterCategory('infra')" class="category-pill px-3 py-1.5 text-xs font-medium rounded-pill bg-white dark:bg-dark-surface text-gray-900 dark:text-dark-text border border-gray-200 dark:border-dark-border" data-category="infra">Infra</button>
        </div>

        <!-- Controls Row -->
        <div class="flex flex-wrap gap-3">
          <!-- Language Dropdown -->
          <select id="language-filter" onchange="applyFilters()" class="px-3 py-1.5 text-sm rounded-small bg-white dark:bg-dark-surface text-gray-900 dark:text-dark-text border border-gray-200 dark:border-dark-border">
            <option value="">All Languages</option>
            <option value="python">Python</option>
            <option value="javascript">JavaScript</option>
            <option value="typescript">TypeScript</option>
            <option value="rust">Rust</option>
            <option value="go">Go</option>
            <option value="java">Java</option>
            <option value="cpp">C++</option>
          </select>

          <!-- Time Range -->
          <div class="flex items-center gap-1 bg-white dark:bg-dark-surface border border-gray-200 dark:border-dark-border rounded-small p-0.5">
            <button onclick="setTimeRange('today')" class="time-btn px-3 py-1 text-xs font-medium rounded-pill bg-accent text-white" data-range="today">Today</button>
            <button onclick="setTimeRange('week')" class="time-btn px-3 py-1 text-xs font-medium rounded-pill text-zinc-500 dark:text-zinc-400" data-range="week">This Week</button>
            <button onclick="setTimeRange('month')" class="time-btn px-3 py-1 text-xs font-medium rounded-pill text-zinc-500 dark:text-zinc-400" data-range="month">This Month</button>
          </div>

          <!-- Search Input -->
          <div class="relative flex-1 min-w-[200px]">
            <i class="ph ph-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-zinc-500 dark:text-zinc-400 text-sm"></i>
            <input id="search-input" type="text" placeholder="Search repositories..." oninput="applyFilters()" class="w-full pl-9 pr-4 py-1.5 text-sm rounded-small bg-white dark:bg-dark-surface text-gray-900 dark:text-dark-text border border-gray-200 dark:border-dark-border placeholder-zinc-500">
          </div>
        </div>
      </div>

      <!-- Loading State -->
      <div id="loading-state" class="grid grid-cols-1 md:grid-cols-2 gap-4 hidden">
        <div class="repo-card p-4 rounded-card border border-gray-200 dark:border-dark-border bg-white dark:bg-dark-surface">
          <div class="flex gap-3 mb-3">
            <div class="skeleton w-10 h-10 rounded-lg"></div>
            <div class="flex-1">
              <div class="skeleton h-4 w-32 mb-2"></div>
              <div class="skeleton h-3 w-48"></div>
            </div>
          </div>
          <div class="skeleton h-3 w-full mb-2"></div>
          <div class="skeleton h-3 w-3/4 mb-3"></div>
          <div class="flex gap-2 mb-3">
            <div class="skeleton h-5 w-16 rounded-pill"></div>
            <div class="skeleton h-5 w-20 rounded-pill"></div>
            <div class="skeleton h-5 w-14 rounded-pill"></div>
          </div>
          <div class="flex items-center gap-4">
            <div class="skeleton h-3 w-16"></div>
            <div class="skeleton h-3 w-12"></div>
            <div class="skeleton h-3 w-20"></div>
          </div>
        </div>
        <div class="repo-card p-4 rounded-card border border-gray-200 dark:border-dark-border bg-white dark:bg-dark-surface">
          <div class="flex gap-3 mb-3">
            <div class="skeleton w-10 h-10 rounded-lg"></div>
            <div class="flex-1">
              <div class="skeleton h-4 w-32 mb-2"></div>
              <div class="skeleton h-3 w-48"></div>
            </div>
          </div>
          <div class="skeleton h-3 w-full mb-2"></div>
          <div class="skeleton h-3 w-3/4 mb-3"></div>
          <div class="flex gap-2 mb-3">
            <div class="skeleton h-5 w-16 rounded-pill"></div>
            <div class="skeleton h-5 w-20 rounded-pill"></div>
            <div class="skeleton h-5 w-14 rounded-pill"></div>
          </div>
          <div class="flex items-center gap-4">
            <div class="skeleton h-3 w-16"></div>
            <div class="skeleton h-3 w-12"></div>
            <div class="skeleton h-3 w-20"></div>
          </div>
        </div>
      </div>

      <!-- Empty State -->
      <div id="empty-state" class="hidden py-16 text-center">
        <i class="ph ph-magnifying-glass text-4xl text-zinc-600 mb-4"></i>
        <h3 class="text-lg font-medium text-gray-900 dark:text-dark-text mb-1">No repositories found</h3>
        <p class="text-sm text-zinc-500 dark:text-zinc-400">Try adjusting your filters or search terms.</p>
      </div>

      <!-- Repository Grid -->
      <div id="trending-grid" class="grid grid-cols-1 md:grid-cols-2 gap-4"></div>
    </div>

    <!-- OPPORTUNITY PAGE -->
    <div id="page-opportunity" class="hidden">
      <!-- Page Header -->
      <div class="mb-6">
        <h1 class="text-3xl font-semibold tracking-tight leading-none text-gray-900 dark:text-dark-text mb-2">Opportunity Scout</h1>
        <p class="text-sm text-zinc-500 dark:text-zinc-400">Hunt for high-potential repositories. Filter by opportunity profile below.</p>
      </div>

      <!-- Opportunity Type Cards -->
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 mb-6">
        <button onclick="selectOpportunityType('all')" class="opp-type-card selected p-3 rounded-card border border-gray-200 dark:border-dark-border bg-white dark:bg-dark-surface text-left" data-opp="all">
          <i class="ph ph-stack text-lg text-accent mb-2"></i>
          <h4 class="text-sm font-medium text-gray-900 dark:text-dark-text mb-1">All Types</h4>
          <p class="text-xs text-zinc-500 dark:text-zinc-400 line-clamp-2">View all opportunity categories</p>
        </button>
        <button onclick="selectOpportunityType('rising')" class="opp-type-card p-3 rounded-card border border-gray-200 dark:border-dark-border bg-white dark:bg-dark-surface text-left" data-opp="rising">
          <i class="ph ph-trend-up text-lg text-green-500 mb-2"></i>
          <h4 class="text-sm font-medium text-gray-900 dark:text-dark-text mb-1">Rising Stars</h4>
          <p class="text-xs text-zinc-500 dark:text-zinc-400 line-clamp-2">Fast-growing repos needing early contributors</p>
        </button>
        <button onclick="selectOpportunityType('bounty')" class="opp-type-card p-3 rounded-card border border-gray-200 dark:border-dark-border bg-white dark:bg-dark-surface text-left" data-opp="bounty">
          <i class="ph ph-currency-circle-dollar text-lg text-accent mb-2"></i>
          <h4 class="text-sm font-medium text-gray-900 dark:text-dark-text mb-1">Issue Bounty</h4>
          <p class="text-xs text-zinc-500 dark:text-zinc-400 line-clamp-2">Issues tagged with bounties or rewards</p>
        </button>
        <button onclick="selectOpportunityType('abandoned')" class="opp-type-card p-3 rounded-card border border-gray-200 dark:border-dark-border bg-white dark:bg-dark-surface text-left" data-opp="abandoned">
          <i class="ph ph-archive text-lg text-amber-500 mb-2"></i>
          <h4 class="text-sm font-medium text-gray-900 dark:text-dark-text mb-1">Abandoned Gold</h4>
          <p class="text-xs text-zinc-500 dark:text-zinc-400 line-clamp-2">High-star repos with inactive maintainers</p>
        </button>
        <button onclick="selectOpportunityType('firstpr')" class="opp-type-card p-3 rounded-card border border-gray-200 dark:border-dark-border bg-white dark:bg-dark-surface text-left" data-opp="firstpr">
          <i class="ph ph-hand-waving text-lg text-green-500 mb-2"></i>
          <h4 class="text-sm font-medium text-gray-900 dark:text-dark-text mb-1">First PR Friendly</h4>
          <p class="text-xs text-zinc-500 dark:text-zinc-400 line-clamp-2">Issues labeled for first-time contributors</p>
        </button>
        <button onclick="selectOpportunityType('design')" class="opp-type-card p-3 rounded-card border border-gray-200 dark:border-dark-border bg-white dark:bg-dark-surface text-left" data-opp="design">
          <i class="ph ph-paint-brush-broad text-lg text-purple-500 mb-2"></i>
          <h4 class="text-sm font-medium text-gray-900 dark:text-dark-text mb-1">Design Polish</h4>
          <p class="text-xs text-zinc-500 dark:text-zinc-400 line-clamp-2">Frontend, UI/UX styling and layout polish</p>
        </button>
      </div>

      <!-- Loading State -->
      <div id="opp-loading-state" class="grid grid-cols-1 md:grid-cols-2 gap-4 hidden">
        <div class="repo-card p-4 rounded-card border border-gray-200 dark:border-dark-border bg-white dark:bg-dark-surface">
          <div class="flex gap-3 mb-3">
            <div class="skeleton w-10 h-10 rounded-lg"></div>
            <div class="flex-1">
              <div class="skeleton h-4 w-32 mb-2"></div>
              <div class="skeleton h-3 w-48"></div>
            </div>
          </div>
          <div class="skeleton h-3 w-full mb-2"></div>
          <div class="skeleton h-3 w-3/4 mb-3"></div>
          <div class="flex gap-2 mb-3">
            <div class="skeleton h-5 w-16 rounded-pill"></div>
            <div class="skeleton h-5 w-20 rounded-pill"></div>
          </div>
          <div class="flex items-center gap-4">
            <div class="skeleton h-3 w-16"></div>
            <div class="skeleton h-3 w-12"></div>
          </div>
        </div>
        <div class="repo-card p-4 rounded-card border border-gray-200 dark:border-dark-border bg-white dark:bg-dark-surface">
          <div class="flex gap-3 mb-3">
            <div class="skeleton w-10 h-10 rounded-lg"></div>
            <div class="flex-1">
              <div class="skeleton h-4 w-32 mb-2"></div>
              <div class="skeleton h-3 w-48"></div>
            </div>
          </div>
          <div class="skeleton h-3 w-full mb-2"></div>
          <div class="skeleton h-3 w-3/4 mb-3"></div>
          <div class="flex gap-2 mb-3">
            <div class="skeleton h-5 w-16 rounded-pill"></div>
            <div class="skeleton h-5 w-20 rounded-pill"></div>
          </div>
          <div class="flex items-center gap-4">
            <div class="skeleton h-3 w-16"></div>
            <div class="skeleton h-3 w-12"></div>
          </div>
        </div>
      </div>

      <!-- Empty State -->
      <div id="opp-empty-state" class="hidden py-16 text-center">
